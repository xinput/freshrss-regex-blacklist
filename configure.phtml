<?php
	declare(strict_types=1);
	/** @var RegexBlacklistExtension $this */

	$rulesJson = $this->getUserConfigurationString('rules') ?? '[]';
	$rules = json_decode($rulesJson, true);
	if (!is_array($rules)) {
		$rules = [];
	}
	$rules = array_values($rules);

	$feeds = FreshRSS_Factory::createFeedDao()->listFeeds();

	/**
	 * Renders one rule as a self-contained card.
	 * $index is either an int (existing rule) or the literal string
	 * '__INDEX__' (blank card rendered once into the <template>, replaced
	 * client-side by script.js on "Add Rule").
	 *
	 * @param array<string,mixed> $rule
	 * @param int|string $index
	 * @param FreshRSS_Feed[] $feeds
	 */
	$renderRuleCard = function (array $rule, $index, array $feeds): void {
		$id = htmlspecialchars((string) ($rule['id'] ?? ''), ENT_COMPAT, 'UTF-8');
		$name = htmlspecialchars((string) ($rule['name'] ?? ''), ENT_COMPAT, 'UTF-8');
		$pattern = htmlspecialchars((string) ($rule['pattern'] ?? ''), ENT_COMPAT, 'UTF-8');
		$matchField = (string) ($rule['match_field'] ?? 'both');
		$feedId = (int) ($rule['feed_id'] ?? 0);
		$enabled = (bool) ($rule['enabled'] ?? true);
		$blockedCount = (int) ($rule['blocked_count'] ?? 0);
		$idxAttr = htmlspecialchars((string) $index, ENT_COMPAT, 'UTF-8');
		?>
		<div class="regex-blacklist-rule" data-index="<?= $idxAttr ?>">
			<input type="hidden" name="rules[<?= $idxAttr ?>][id]" value="<?= $id ?>" />

			<div class="regex-blacklist-rule-header">
				<label class="regex-blacklist-enabled-label">
					<input type="checkbox" name="rules[<?= $idxAttr ?>][enabled]" value="1" <?= $enabled ? 'checked' : '' ?> />
					Enabled
				</label>
				<input
					type="text"
					class="regex-blacklist-name"
					name="rules[<?= $idxAttr ?>][name]"
					value="<?= $name ?>"
					placeholder="Rule name, e.g. Block sponsored posts"
				/>
				<span class="regex-blacklist-blocked-count" title="Articles blocked by this rule">Blocked: <?= $blockedCount ?></span>
				<button type="button" class="btn regex-blacklist-remove-btn">Remove</button>
			</div>

			<div class="regex-blacklist-field">
				<label>Regex Pattern</label>
				<div class="regex-blacklist-pattern-row">
					<input
						type="text"
						class="regex-blacklist-pattern"
						name="rules[<?= $idxAttr ?>][pattern]"
						value="<?= $pattern ?>"
						placeholder="sponsor|advert"
					/>
					<button type="button" class="btn regex-blacklist-test-btn">Test</button>
				</div>
			</div>

			<div class="regex-blacklist-scope-row">
				<label class="regex-blacklist-scope-field">
					Match
					<select name="rules[<?= $idxAttr ?>][match_field]">
						<option value="both" <?= $matchField === 'both' ? 'selected' : '' ?>>Title + Content</option>
						<option value="title" <?= $matchField === 'title' ? 'selected' : '' ?>>Title only</option>
						<option value="content" <?= $matchField === 'content' ? 'selected' : '' ?>>Content only</option>
						<option value="author" <?= $matchField === 'author' ? 'selected' : '' ?>>Author</option>
					</select>
				</label>
				<label class="regex-blacklist-scope-field">
					Applies to Feed
					<select name="rules[<?= $idxAttr ?>][feed_id]">
						<option value="0" <?= $feedId === 0 ? 'selected' : '' ?>>All feeds</option>
						<?php foreach ($feeds as $feed): ?>
							<option value="<?= $feed->id() ?>" <?= $feedId === $feed->id() ? 'selected' : '' ?>>
								<?= htmlspecialchars($feed->name(), ENT_COMPAT, 'UTF-8') ?>
							</option>
						<?php endforeach; ?>
					</select>
				</label>
			</div>

			<div class="regex-blacklist-tester" hidden>
				<label>Sample text to test this pattern against</label>
				<textarea class="regex-blacklist-sample" rows="2" placeholder="Paste a title or content snippet"></textarea>
				<p class="regex-blacklist-test-result"></p>
				<p class="help">Uses your browser's regex engine (JavaScript), a close approximation of PHP's PCRE — verify against real content if in doubt.</p>
			</div>
		</div>
		<?php
	};
?>
<div class="container" id="regexBlacklistApp">
	<h2><?= $this->getName() ?></h2>

	<p><?= $this->getDescription() ?></p>

	<form method="post" action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>">
		<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />

		<fieldset>
			<legend>Blacklist Rules</legend>

			<div id="regexBlacklistRulesBody">
				<?php foreach ($rules as $index => $rule): ?>
					<?php $renderRuleCard($rule, $index, $feeds); ?>
				<?php endforeach; ?>
			</div>

			<p>
				<button type="button" class="btn" id="regexBlacklistAddRule">+ Add Rule</button>
			</p>

			<p class="help">
				Regex patterns use PHP PCRE syntax (no delimiters, e.g. <code>sponsor</code> or <code>(clickbait|click-bait)</code>), matched case-insensitively.
				The first enabled rule that matches blocks the article from import.
			</p>
		</fieldset>

		<div class="form-group form-actions">
			<div class="group-controls">
				<button type="submit" class="btn btn-important">Save Configuration</button>
			</div>
		</div>
	</form>

	<template id="regexBlacklistRowTemplate">
		<?php $renderRuleCard(
			['id' => '', 'name' => '', 'pattern' => '', 'match_field' => 'both', 'feed_id' => 0, 'enabled' => true, 'blocked_count' => 0],
			'__INDEX__',
			$feeds
		); ?>
	</template>
</div>
