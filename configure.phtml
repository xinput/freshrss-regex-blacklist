<?php
	declare(strict_types=1);
	/** @var RegexBlacklistExtension $this */
?>
<div class="container">
	<h2><?= $this->getName() ?></h2>

	<p><?= $this->getDescription() ?></p>

	<form method="post" action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>">
		<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />

		<fieldset>
			<legend>Global Patterns</legend>

			<div class="form-group">
				<label class="group-name" for="global_patterns">
					<strong>Regex Patterns (one per line)</strong>
				</label>
				<div class="group-controls">
					<textarea
						name="global_patterns"
						id="global_patterns"
						class="w100"
						rows="10"
						placeholder="Example: &#10;sponsored&#10;^Ad:&#10;click-?bait&#10;(sponsor|advertisement)"
					><?= htmlspecialchars($this->getUserConfigurationString('global_patterns') ?? '', ENT_COMPAT, 'UTF-8') ?></textarea>
				</div>
				<p class="help">
					<strong>Tips:</strong>
					<ul>
						<li>Patterns are matched against article <strong>title and content</strong></li>
						<li>Matching is <strong>case-insensitive</strong></li>
						<li>Use standard PHP regex syntax (without delimiters)</li>
						<li>Examples:
							<ul>
								<li><code>sponsor</code> — matches "Sponsored" or "sponsorship"</li>
								<li><code>^Ad:</code> — matches titles starting with "Ad:"</li>
								<li><code>(clickbait|click-bait)</code> — matches either variant</li>
							</ul>
						</li>
						<li><strong>Articles matching any pattern will not be imported</strong></li>
					</ul>
				</p>
			</div>

			<div class="form-group form-actions">
				<div class="group-controls">
					<button type="submit" class="btn btn-important">Save Configuration</button>
				</div>
			</div>
		</fieldset>
	</form>

	<?php
		$stats = $this->getUserConfigurationString('stats') ?? '{}';
		$statsArray = json_decode($stats, true);
		$statsArray = is_array($statsArray) ? $statsArray : [];
	?>
	<?php if (!empty($statsArray)): ?>
		<fieldset>
			<legend>Statistics</legend>
			<p><strong>Articles Blocked:</strong></p>
			<ul>
				<?php foreach ($statsArray as $source => $count): ?>
					<li><?= htmlspecialchars((string) $source, ENT_COMPAT, 'UTF-8') ?>: <strong><?= (int) $count ?></strong></li>
				<?php endforeach; ?>
			</ul>
		</fieldset>
	<?php endif; ?>
</div>
