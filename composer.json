{
  "name": "pascalis/freshrss-regex-blacklist",
  "description": "FreshRSS extension for regex-based article filtering at import time",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Your Name",
      "email": "your.email@example.com"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5|^10.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "scripts": {
    "test": "phpunit tests/",
    "test-coverage": "phpunit --coverage-html coverage/ tests/",
    "phpstan": "phpstan analyse extension.php",
    "phpcs": "phpcs --standard=PSR12 extension.php",
    "lint": [
      "@phpstan",
      "@phpcs"
    ],
    "check": [
      "@lint",
      "@test"
    ]
  }
}
